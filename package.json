{
  "name": "qubetics_wallet_processes",
  "version": "1.0.0",
  "description": "Process for qubetics wallet bsc blockchain",
  "main": "index.bsc.ts",
  "scripts": {
    "compile": "tsc",
    "server": "nodemon --max-old-space-size=2048 build/index.bsc.js",
    "dev": "npm run compile && npm run server",
    "start": "npm run compile && cp -r bn.js ./node_modules/number-to-bn/node_modules/bn.js/lib && node build/index.bsc.js"
  },
  "keywords": [
    "processes"
  ],
  "author": "Qubetics",
  "license": "ISC",
  "dependencies": {
    "@types/bignumber.js": "^5.0.0",
    "@types/node": "^16.3.2",
    "@types/node-schedule": "^1.3.2",
    "@types/redis": "^2.8.31",
    "@types/sequelize": "^4.28.10",
    "axios": "^0.21.1",
    "bignumber.js": "^9.0.1",
    "dotenv": "^14.3.2",
    "firebase-admin": "^13.0.1",
    "kafkajs": "^2.2.4",
    "mysql2": "^2.3.0",
    "node-schedule": "^2.0.0",
    "node-zookeeper-client": "^1.1.3",
    "nodemon": "^2.0.12",
    "redis": "^3.1.2",
    "sequelize": "^6.6.5",
    "typescript": "^4.3.5",
    "web3": "^1.4.0",
    "web3-utils": "^1.4.0"
  },
  "devDependencies": {
    "@types/node-zookeeper-client": "^0.2.8"
  }
}
